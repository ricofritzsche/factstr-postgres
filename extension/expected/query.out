    SELECT sequence_number, event_type, payload
    FROM factstr.query(
        ARRAY['account.created', 'account.credited', 'account.debited'],
        '{"account_id":"acct_1"}',
        3
    )
    ORDER BY sequence_number
) TO STDOUT;
